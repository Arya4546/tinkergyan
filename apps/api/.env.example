# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/tinkergyan?schema=public"

# AUTH
JWT_SECRET="generate-a-32-character-random-string-here"
JWT_EXPIRES_IN="7d"

# SERVER
PORT=3001
NODE_ENV=development

# REDIS (Optional for Phase 1)
# REDIS_URL="redis://localhost:6379"

# CORS / FRONTEND
FRONTEND_URL="http://localhost:5173"

# SANDBOX (Phase 2)
MAX_COMPILE_TIMEOUT=180000
COMPILE_CONCURRENCY=5

# SUPER ADMIN (created on server start if it does not exist yet)
# Set all of these in the deployed environment too. Use a strong password and
# change it after first login. Never commit real values.
ADMIN_EMAIL="admin@example.com"
ADMIN_FULL_NAME="Super Admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"
